!receipts.json
!.opencode/
!.opencode/**
!src/
!src/**
!tests/
!tests/**
# Generated artifacts stay ignored even inside whitelisted trees
__pycache__/
*.pyc
*.egg-info/
.venv/
logs/
doc_output/
cache/
cache/
cache/
cache/